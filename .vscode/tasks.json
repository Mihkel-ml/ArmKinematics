{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build arm sim",
            "command": "g++",
            "args": [
                "-std=c++17",
                "src/main.cpp",
                "src/Arm.cpp",
                "-Iinclude",
                "-Llib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-o",
                "build/sim.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
